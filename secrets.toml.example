# Copy to .streamlit/secrets.toml locally (never commit it), or paste into
# Streamlit Cloud -> App settings -> Secrets. Top-level keys also become environment variables.

# Creates the first administrator automatically on startup (recommended for public sites)
ADMIN_EMAIL = "you@example.com"
ADMIN_PASSWORD = "choose-a-long-passphrase-1"
ADMIN_NAME = "Site Admin"

# Optional: e-mail delivery of password-reset codes. Without these, reset requests go to the admin queue.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASS = "app-password"
SMTP_FROM = "PDF ToolHub <you@gmail.com>"
